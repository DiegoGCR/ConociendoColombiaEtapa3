MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1831105949}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f66c85398be521f4aa53aa598b0f922f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TriviaManager
  triviaList:
  - regionName: "Regi\xF3n Andina"
    culturalFact: "Colombia es el mayor productor mundial de esmeraldas de alta calidad,
      siendo las minas de Muzo y Chiquinquir\xE1 (Boyac\xE1) las m\xE1s famosas del
      mundo por su caracter\xEDstico tono verde intenso."
    questionText: "\xBFCu\xE1l es departamento de Colombia reconocido mundialmente
      por la producci\xF3n y extracci\xF3n de las mejores esmeraldas?"
    hint: "Es un departamento del centro de Colombia cuya capital es Tunja, muy famoso
      tambi\xE9n por su ciclismo y por ser escenario de la batalla final de la independencia.
      Lee con atenci\xF3n la pregunta."
    options:
    - A. Antioquia
    - "B. Boyac\xE1"
    - C. Cundinamarca
    correctAnswerIndex: 1
  - regionName: "Regi\xF3n Andina"
    culturalFact: "El Poporo Quimbaya es una obra maestra de la orfebrer\xEDa precolombina
      hecha en aleaci\xF3n de oro y cobre, utilizada por los ind\xEDgenas para almacenar
      la cal en rituales de mambeo de hoja de coca."
    questionText: "\xBFQu\xE9 cultura precolombina elabor\xF3 el ic\xF3nico Poporo
      Quimbaya, considerado una joya de la orfebrer\xEDa ind\xEDgena?"
    hint: "Esta civilizaci\xF3n precolombina habit\xF3 en la regi\xF3n del actual
      Eje Cafetero de Colombia, especialmente en los departamentos de Quind\xEDo,
      Risaralda y Caldas. Lee con mucha atenci\xF3n la pregunta."
    options:
    - A. Cultura Quimbaya
    - B. Cultura Tairona
    - "C. Cultura Zen\xFA"
    correctAnswerIndex: 0
  - regionName: "Regi\xF3n Andina"
    culturalFact: "El Parque Arqueol\xF3gico de San Agust\xEDn, ubicado en el departamento
      del Huila, alberga la mayor concentraci\xF3n de monumentos megal\xEDticos y
      estatuas de piedra de Suram\xE9rica, esculpidas por una civilizaci\xF3n ancestral."
    questionText: "\xBFEn qu\xE9 departamento de Colombia se encuentra el famoso
      Parque Arqueol\xF3gico conocido por sus enigm\xE1ticas estatuas y monolitos
      de piedra?"
    hint: "Es un departamento del suroccidente colombiano cuya capital es Neiva,
      famoso por el desierto de la Tatacoa y por celebrar las fiestas del San Pedro.
      F\xEDjate muy bien en la pregunta. "
    options:
    - A. Tolima
    - B. Huila
    - C. Cauca
    correctAnswerIndex: 1
  triviaPanel: {fileID: 1406613828}
  regionText: {fileID: 1792312417}
  factText: {fileID: 359159053}
  questionText: {fileID: 1719874912}
  feedbackText: {fileID: 1664947488}
